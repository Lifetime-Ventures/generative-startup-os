{
  "_comment": "Claude Code MCP configuration file. Copy to ~/.claude/claude_mcp_config.json and fill in your API keys. DO NOT commit this file to git.",
  "_security": "See WHAT-NOT-TO-INPUT.md before connecting Gmail or Slack. Never input unpublished patents, patient data, or export-controlled technology.",
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-notion"],
      "env": {
        "NOTION_API_TOKEN": "secret_YOUR_TOKEN_HERE"
      }
    },
    "google-calendar": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-google-calendar"],
      "env": {
        "GOOGLE_CLIENT_ID": "YOUR_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET": "YOUR_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN": "YOUR_REFRESH_TOKEN"
      }
    },
    "granola": {
      "_warning": "Verify this package name at https://granola.ai/docs before running. Package names may change.",
      "command": "npx",
      "args": ["-y", "@granola-ai/mcp-server"],
      "env": {
        "GRANOLA_API_KEY": "YOUR_GRANOLA_API_KEY"
      }
    },
    "circleback": {
      "_warning": "Verify this package name at https://circleback.ai/docs before running. Package names may change.",
      "command": "npx",
      "args": ["-y", "@circleback/mcp-server"],
      "env": {
        "CIRCLEBACK_API_KEY": "YOUR_CIRCLEBACK_API_KEY"
      }
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-YOUR_BOT_TOKEN"
      }
    },
    "gmail": {
      "_security": "Before connecting Gmail, review WHAT-NOT-TO-INPUT.md. NDA materials and confidential investor communications should not be auto-scanned.",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-gmail"],
      "env": {
        "GMAIL_CLIENT_ID": "YOUR_GMAIL_CLIENT_ID",
        "GMAIL_CLIENT_SECRET": "YOUR_GMAIL_CLIENT_SECRET",
        "GMAIL_REFRESH_TOKEN": "YOUR_GMAIL_REFRESH_TOKEN"
      }
    }
  }
}
